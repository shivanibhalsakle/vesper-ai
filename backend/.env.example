# Application environment
ENVIRONMENT=development

# Database connection (Docker service name: 'db')
DATABASE_URL=postgresql://postgres:postgres@db:5432/sunset

# Redis connection (Docker service name: 'redis')
REDIS_URL=redis://redis:6379/0

# AI/LLM API keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Geoapify geocoding key (free tier: 3,000 requests/day) � geoapify.com
GEOAPIFY_API_KEY=

# Firebase credentials (path to the service account JSON file)
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json

# Firebase Storage bucket for saved sky previews (Firebase console > Storage;
# the name shown beside "Storage", e.g. your-project.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=

# Shared secret for /internal/* endpoints (e.g. the daily notification
# rescore) — generate a random string, e.g. `openssl rand -hex 32`
INTERNAL_API_SECRET=
