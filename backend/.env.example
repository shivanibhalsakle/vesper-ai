# Application environment
ENVIRONMENT=development

# Database connection (Docker service name: 'db')
DATABASE_URL=postgresql://postgres:postgres@db:5432/sunset

# Redis connection (Docker service name: 'redis')
REDIS_URL=redis://redis:6379/0

# AI/LLM API keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Firebase credentials (if using backend services)
FIREBASE_CREDENTIALS_JSON=
